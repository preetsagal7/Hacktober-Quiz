# ============================================================
# Hacktober 2026 — CyberQuiz Backend Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
DATABASE_URL=sqlite+aiosqlite:///./cyberquiz.db

# ---- JWT ----
JWT_SECRET_KEY=REPLACE_WITH_ANOTHER_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=1

# ---- Admin Bootstrap (used ONLY for first-time setup) ----
# After first run, credentials are stored hashed in the DB.
# Remove or blank these after initial setup for security.
INITIAL_ADMIN_ID=Quiz@Cyber26
INITIAL_ADMIN_PASSWORD=CyberHack@2026

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5/minute

# ---- Event Settings ----
EVENT_NAME=Hacktober 2026
EVENT_TIMEZONE=Asia/Kolkata

# ---- Certificate ----
CERT_SIGNING_SECRET=REPLACE_WITH_CERT_SIGNING_SECRET
